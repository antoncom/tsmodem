#!/bin/sh /etc/rc.common

START=30
STOP=82
USE_PROCD=1

SERVICE=/usr/sbin/tsmodem
SERVICE_USE_PID=1

  . /lib/functions.sh
INCLUDE_ONLY=1 . $SERVICE

start_service() {
    procd_open_instance 'tsmodem'

    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param command $SERVICE
    procd_set_param pidfile $SERVICE_PID_FILE
    procd_close_instance

}

service_triggers()
{
    procd_add_reload_trigger "tsmodem"
}

stop_service() {
    kill -9 `ps | grep '/usr/lib/lua/tsmodem/app.lua' | grep -v grep | awk '{print $1}'`

}

service_started() {
    # перезапускаем сервисы для возобновления подписки на Tsmodem только если они сейчас запущены
    ( sleep 1; /etc/init.d/applogic restart ) >/dev/null 2>&1 &
    ( sleep 1; /etc/init.d/tsmatconsole restart ) >/dev/null 2>&1 &
    ( sleep 1; /etc/init.d/tsmsms restart ) >/dev/null 2>&1 &
    ( sleep 1; /etc/init.d/tsmsmsconsole restart ) >/dev/null 2>&1 &
}
